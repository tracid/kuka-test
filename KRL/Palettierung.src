&ACCESS RVP
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF Palettierung( )
;=====================================================================
; Sackpalettierung  600 x 400 x 200 mm  ->  Europalette 1200 x 800 mm
; 4 Lagen x 4 Saecke = 16 Saecke je Palette
;---------------------------------------------------------------------
; Roboter   : KUKA KR QUANTEC PA, z.B. KR 180 R3200 PA (3195 mm)
; Steuerung : KR C5 / KR C4 mit KSS 8.x
; Greifer   : Sackgabelgreifer (Gabelhaelften auf/zu + Niederhalter)
;             TCP = Mitte des gegriffenen Sacks (TOOL_DATA[nTool])
; Aufnahme  : Rollenbahn mit Gabelaufnahme seitlich der Palette
;---------------------------------------------------------------------
; Parameter, Lagenmuster, E/A-Nummern und Zaehler: Palettierung.dat
; Alle Zielpunkte werden in Weltkoordinaten berechnet ($BASE = WORLD),
; ausgehend von Palettenbasis bzw. Aufnahmebasis (Funktion ZielWelt).
;=====================================================================
  ;FOLD INI;%{PE}
    ;FOLD BASISTECH INI
      GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
      INTERRUPT ON 3
      BAS (#INITMOV,0 )
    ;ENDFOLD (BASISTECH INI)
    ;FOLD USER INI
      ;Make your modifications here
    ;ENDFOLD (USER INI)
  ;ENDFOLD (INI)

  PalInit()

  ; SAK-Fahrt: erste Bewegung achsspezifisch auf HOME
  PTP XHOME

  bEnde = FALSE
  WHILE NOT bEnde
    ; ---- Palette voll -> Palettenwechsel
    IF nLage > nLagen THEN
      PaletteWechsel()
    ENDIF

    ; ---- einen Sack palettieren
    IF NOT bSackImGr THEN
      SackAufnehmen()
    ENDIF
    IF bSackImGr THEN
      SackAblegen()
    ENDIF

    ; ---- Zyklusende angewaehlt? (Abfrage im Vorlauf, kein Vorlaufstopp)
    CONTINUE
    bEnde = $IN[nInZyklEnde]
  ENDWHILE

  ; ---- Zyklusende: Grundstellung, Zaehler bleiben erhalten
  PTP XHOME
END

;=====================================================================
; Initialisierung
;=====================================================================
DEF PalInit( )
  ; --- Werkzeug, Basis, Interpolationsmodus
  $TOOL = TOOL_DATA[nTool]
  $BASE = $NULLFRAME
  $IPO_MODE = #BASE

  ; --- Geschwindigkeit, Beschleunigung, Ueberschleifen
  BAS (#VEL_PTP, rVelPTP)
  BAS (#ACC_PTP, rAccPTP)
  BAS (#VEL_CP, rVelCP)
  BAS (#ACC_CP, rAccCP)
  $APO.CPTP = nApoPTP
  $APO.CDIS = rApoDis
  $ADVANCE = 3

  ; --- Daten pruefen
  nMeldHandle = 0
  DatenPruefen()

  ; --- Ausgaenge Grundstellung
  $OUT[nOutSackEntn] = FALSE
  $OUT[nOutPalVoll] = FALSE

  ; --- Greiferzustand uebernehmen (Sack evtl. noch vom letzten Zyklus)
  bSackImGr = $IN[nInSackImGr]
  IF bSackImGr THEN
    $LOAD = ldVoll
    Meld_Hinweis(4)
  ELSE
    $LOAD = ldLeer
    GabelAuf()
    NiederhalterAuf()
  ENDIF
END

;=====================================================================
; Plausibilitaet von Werkzeug, Basen und Parametern
;=====================================================================
DEF DatenPruefen( )
  IF ABS(TOOL_DATA[nTool].Z) < 1.0 THEN
    Meld_Quit(1)
    HALT
  ENDIF
  IF nBasePal > 0 THEN
    IF (ABS(BASE_DATA[nBasePal].X) + ABS(BASE_DATA[nBasePal].Y)) < 1.0 THEN
      Meld_Quit(2)
      HALT
    ENDIF
  ENDIF
  IF nBasePick > 0 THEN
    IF (ABS(BASE_DATA[nBasePick].X) + ABS(BASE_DATA[nBasePick].Y)) < 1.0 THEN
      Meld_Quit(3)
      HALT
    ENDIF
  ENDIF
  IF (nLagen < 1) OR (nSackProLage < 1) OR (nSackProLage > 8) THEN
    Meld_Quit(5)
    HALT
  ENDIF
  ; Zaehler ausserhalb des gueltigen Bereichs -> neue Palette
  IF (nLage < 1) OR (nSack < 1) OR (nSack > nSackProLage) THEN
    nLage = 1
    nSack = 1
  ENDIF
END

;=====================================================================
; Sack an der Aufnahme greifen
;=====================================================================
DEF SackAufnehmen( )
  ; --- Zielpunkte (Aufnahmebasis -> Welt)
  fPickUeber = ZielWelt(2, rPickX, rPickY, rPickZ + rPickUeberZ, rPickA)
  fPickVor   = ZielWelt(2, rPickX, rPickY, rPickZ + rPickVorZ, rPickA)
  fPick      = ZielWelt(2, rPickX, rPickY, rPickZ + rPickTief, rPickA)

  ; --- Ueberfahrhoehe ueber der Aufnahme
  $VEL.CP = rVelCP
  PTP fPickUeber
  $OUT[nOutSackEntn] = FALSE

  ; --- Greifer bereit: Gabel offen, Niederhalter oben
  GabelAuf()
  NiederhalterAuf()

  ; --- auf Sack warten (Zyklusende beendet auch das Warten)
  IF NOT $IN[nInSackDa] THEN
    Meld_Status(10)
    WAIT FOR $IN[nInSackDa] OR $IN[nInZyklEnde]
    Meld_Loeschen()
    IF NOT $IN[nInSackDa] THEN
      RETURN
    ENDIF
  ENDIF

  ; --- absenken: schnell bis Vorposition, dann langsam unter den Sack
  LIN fPickVor C_DIS
  $VEL.CP = rVelCPLangsam
  LIN fPick

  ; --- greifen: Gabelhaelften fahren zwischen den Rollen unter den Sack
  GabelZu()
  NiederhalterAb()

  ; --- Kontrolle: Sack im Greifer?
  WHILE NOT $IN[nInSackImGr]
    Meld_Quit(20)
    GabelAuf()
    NiederhalterAuf()
    WAIT FOR $IN[nInSackDa]
    GabelZu()
    NiederhalterAb()
  ENDWHILE
  bSackImGr = TRUE
  $LOAD = ldVoll

  ; --- anheben; Foerderer freigeben, sobald die Gabel frei ist
  $VEL.CP = rVelCP
  TRIGGER WHEN DISTANCE=1 DELAY=0 DO $OUT[nOutSackEntn]=TRUE
  LIN fPickUeber C_DIS
END

;=====================================================================
; Sack nach Lagenmuster auf der Palette ablegen
;=====================================================================
DEF SackAblegen( )
  DECL INT nMus
  DECL REAL rX, rY, rZ, rA, rVX, rVY
  DECL BOOL bPalOk

  ; --- Lagenmuster: ungerade Lage -> Muster 1, gerade Lage -> Muster 2
  IF (nLage MOD 2) == 1 THEN
    nMus = 1
  ELSE
    nMus = 2
  ENDIF
  rX  = Muster[nMus,nSack].X
  rY  = Muster[nMus,nSack].Y
  rA  = Muster[nMus,nSack].A
  rVX = Muster[nMus,nSack].VX * rVorXY
  rVY = Muster[nMus,nSack].VY * rVorXY
  ; --- Sackmitte in der aktuellen Lage
  rZ  = rPalZ0 + (nLage - 1) * rLagenH + 0.5 * rLagenH

  ; --- Zielpunkte (Palettenbasis -> Welt)
  fUeber   = ZielWelt(1, rX + rVX, rY + rVY, rZ + rUeberZ, rA)
  fVor     = ZielWelt(1, rX + rVX, rY + rVY, rZ + rVorZ, rA)
  fAblage  = ZielWelt(1, rX, rY, rZ + rAblageZ, rA)
  fAbheben = ZielWelt(1, rX, rY, rZ + rUeberZ, rA)

  ; --- Palette bereit? (Abfrage im Vorlauf, kein Vorlaufstopp)
  CONTINUE
  bPalOk = $IN[nInPalBereit]
  IF NOT bPalOk THEN
    Meld_Status(11)
    WAIT FOR $IN[nInPalBereit]
    Meld_Loeschen()
  ENDIF

  ; --- Ueberfahrhoehe seitlich versetzt, dann schraeg an die Nachbarn
  $VEL.CP = rVelCP
  PTP fUeber C_PTP
  LIN fVor C_DIS
  $VEL.CP = rVelCPLangsam
  LIN fAblage

  ; --- Kontrolle: Sack noch im Greifer?
  IF NOT $IN[nInSackImGr] THEN
    Meld_Quit(21)
    bSackImGr = FALSE
    $LOAD = ldLeer
    $VEL.CP = rVelCP
    LIN fAbheben
    RETURN
  ENDIF

  ; --- ablegen: Gabel oeffnen, Niederhalter haelt den Sack
  GabelAuf()
  NiederhalterAuf()
  bSackImGr = FALSE
  $LOAD = ldLeer
  Weiterzaehlen()

  ; --- senkrecht abheben
  $VEL.CP = rVelCP
  LIN fAbheben C_DIS
END

;=====================================================================
; Sack- und Lagenzaehler weiterschalten
;=====================================================================
DEF Weiterzaehlen( )
  nSack = nSack + 1
  IF nSack > nSackProLage THEN
    nSack = 1
    nLage = nLage + 1
  ENDIF
END

;=====================================================================
; Palette voll: freifahren, Wechsel anfordern, auf leere Palette warten
;=====================================================================
DEF PaletteWechsel( )
  PTP XHOME
  $OUT[nOutPalVoll] = TRUE
  Meld_Status(12)
  ; volle Palette wird abgefoerdert ...
  WAIT FOR NOT $IN[nInPalBereit]
  ; ... und neue leere Palette steht bereit
  WAIT FOR $IN[nInPalBereit]
  $OUT[nOutPalVoll] = FALSE
  Meld_Loeschen()
  nPalGesamt = nPalGesamt + 1
  nLage = 1
  nSack = 1
END

;=====================================================================
; Zielpunkt in Weltkoordinaten
;   nStation    : 1 = Palette, 2 = Aufnahme
;   rX,rY,rZ,rA : TCP (Sackmitte) in der Stationsbasis
; PA-Kinematik: Flansch steht immer waagerecht -> B/C fest
;=====================================================================
DEFFCT FRAME ZielWelt(nStation:IN, rX:IN, rY:IN, rZ:IN, rA:IN)
  DECL INT nStation
  DECL REAL rX, rY, rZ, rA
  DECL FRAME fBas, fLok, fWelt

  IF nStation == 1 THEN
    IF nBasePal > 0 THEN
      fBas = BASE_DATA[nBasePal]
    ELSE
      fBas = fBasisPal
    ENDIF
  ELSE
    IF nBasePick > 0 THEN
      fBas = BASE_DATA[nBasePick]
    ELSE
      fBas = fBasisPick
    ENDIF
  ENDIF

  fLok = $NULLFRAME
  fLok.X = rX
  fLok.Y = rY
  fLok.Z = rZ
  fLok.A = rA
  fLok.B = rOriB
  fLok.C = rOriC

  fWelt = fBas : fLok
  fWelt.B = rOriB
  fWelt.C = rOriC
  RETURN fWelt
ENDFCT

;=====================================================================
; Greifer
;=====================================================================
DEF GabelAuf( )
  DECL BOOL bOk
  bOk = FALSE
  WHILE NOT bOk
    $OUT[nOutGabelZu] = FALSE
    $OUT[nOutGabelAuf] = TRUE
    bOk = WarteEin(nInGabelAuf)
    IF NOT bOk THEN
      Meld_Quit(30)
    ENDIF
  ENDWHILE
END

DEF GabelZu( )
  DECL BOOL bOk
  bOk = FALSE
  WHILE NOT bOk
    $OUT[nOutGabelAuf] = FALSE
    $OUT[nOutGabelZu] = TRUE
    bOk = WarteEin(nInGabelZu)
    IF NOT bOk THEN
      Meld_Quit(31)
    ENDIF
  ENDWHILE
END

DEF NiederhalterAb( )
  ; keine Endlage unten: Niederhalter liegt auf dem Sack auf
  $OUT[nOutNiederAb] = TRUE
  WAIT SEC rNiederZeit
END

DEF NiederhalterAuf( )
  DECL BOOL bOk
  bOk = FALSE
  WHILE NOT bOk
    $OUT[nOutNiederAb] = FALSE
    bOk = WarteEin(nInNiederOben)
    IF NOT bOk THEN
      Meld_Quit(32)
    ENDIF
  ENDWHILE
END

;=====================================================================
; Auf Eingang warten mit Zeitueberwachung (nTimeoutMs)
; Rueckgabe TRUE = Eingang gekommen, FALSE = Zeit abgelaufen
;=====================================================================
DEFFCT BOOL WarteEin(nEingang:IN)
  DECL INT nEingang
  $TIMER_STOP[nTimer] = TRUE
  $TIMER[nTimer] = -nTimeoutMs
  $TIMER_STOP[nTimer] = FALSE
  WAIT FOR $IN[nEingang] OR $TIMER_FLAG[nTimer]
  $TIMER_STOP[nTimer] = TRUE
  RETURN $IN[nEingang]
ENDFCT

;=====================================================================
; Meldungen (KrlMsg)
;=====================================================================
DEF Meld_Quit(nNr:IN)
  ; Quittiermeldung, wartet bis quittiert
  DECL INT nNr
  DECL INT nHandle
  DECL KrlMsg_T Msg
  DECL KrlMsgPar_T Par[3]
  DECL KrlMsgOpt_T Opt

  MeldText(nNr, Msg)
  Par[1] = {Par_Type #EMPTY}
  Par[2] = {Par_Type #EMPTY}
  Par[3] = {Par_Type #EMPTY}
  Opt = {VL_Stop TRUE, Clear_P_Reset TRUE, Clear_P_SAW FALSE, Log_to_DB TRUE}
  nHandle = Set_KrlMsg(#QUIT, Msg, Par[], Opt)
  IF nHandle > 0 THEN
    WHILE Exists_KrlMsg(nHandle)
      WAIT SEC 0.1
    ENDWHILE
  ENDIF
END

DEF Meld_Status(nNr:IN)
  ; Zustandsmeldung, bleibt bis Meld_Loeschen()
  DECL INT nNr
  DECL KrlMsg_T Msg
  DECL KrlMsgPar_T Par[3]
  DECL KrlMsgOpt_T Opt

  Meld_Loeschen()
  MeldText(nNr, Msg)
  Par[1] = {Par_Type #EMPTY}
  Par[2] = {Par_Type #EMPTY}
  Par[3] = {Par_Type #EMPTY}
  Opt = {VL_Stop TRUE, Clear_P_Reset TRUE, Clear_P_SAW FALSE, Log_to_DB FALSE}
  nMeldHandle = Set_KrlMsg(#STATE, Msg, Par[], Opt)
END

DEF Meld_Hinweis(nNr:IN)
  ; Hinweismeldung, ohne Warten
  DECL INT nNr
  DECL INT nHandle
  DECL KrlMsg_T Msg
  DECL KrlMsgPar_T Par[3]
  DECL KrlMsgOpt_T Opt

  MeldText(nNr, Msg)
  Par[1] = {Par_Type #EMPTY}
  Par[2] = {Par_Type #EMPTY}
  Par[3] = {Par_Type #EMPTY}
  Opt = {VL_Stop FALSE, Clear_P_Reset TRUE, Clear_P_SAW FALSE, Log_to_DB FALSE}
  nHandle = Set_KrlMsg(#NOTIFY, Msg, Par[], Opt)
END

DEF Meld_Loeschen( )
  DECL BOOL bOk
  IF nMeldHandle > 0 THEN
    bOk = Clear_KrlMsg(nMeldHandle)
  ENDIF
  nMeldHandle = 0
END

DEF MeldText(nNr:IN, Msg:OUT)
  DECL INT nNr
  DECL KrlMsg_T Msg
  SWITCH nNr
  CASE 1
    Msg = {Modul[] "Palettierung", Nr 1, Msg_txt[] "Werkzeug (TOOL_DATA) nicht vermessen - Programm angehalten"}
  CASE 2
    Msg = {Modul[] "Palettierung", Nr 2, Msg_txt[] "Basis Palette nicht vermessen - Programm angehalten"}
  CASE 3
    Msg = {Modul[] "Palettierung", Nr 3, Msg_txt[] "Basis Aufnahme nicht vermessen - Programm angehalten"}
  CASE 4
    Msg = {Modul[] "Palettierung", Nr 4, Msg_txt[] "Sack im Greifer erkannt - Zyklus beginnt mit Ablage"}
  CASE 5
    Msg = {Modul[] "Palettierung", Nr 5, Msg_txt[] "Lagenparameter unzulaessig (nLagen / nSackProLage)"}
  CASE 10
    Msg = {Modul[] "Palettierung", Nr 10, Msg_txt[] "Warte auf Sack an der Aufnahme"}
  CASE 11
    Msg = {Modul[] "Palettierung", Nr 11, Msg_txt[] "Warte auf Freigabe leere Palette"}
  CASE 12
    Msg = {Modul[] "Palettierung", Nr 12, Msg_txt[] "Palette voll - warte auf Palettenwechsel"}
  CASE 20
    Msg = {Modul[] "Palettierung", Nr 20, Msg_txt[] "Kein Sack im Greifer - Quittieren: erneut greifen"}
  CASE 21
    Msg = {Modul[] "Palettierung", Nr 21, Msg_txt[] "Sack verloren - Quittieren: naechster Sack"}
  CASE 30
    Msg = {Modul[] "Palettierung", Nr 30, Msg_txt[] "Gabel nicht offen - Quittieren: wiederholen"}
  CASE 31
    Msg = {Modul[] "Palettierung", Nr 31, Msg_txt[] "Gabel nicht geschlossen - Quittieren: wiederholen"}
  CASE 32
    Msg = {Modul[] "Palettierung", Nr 32, Msg_txt[] "Niederhalter nicht oben - Quittieren: wiederholen"}
  DEFAULT
    Msg = {Modul[] "Palettierung", Nr 99, Msg_txt[] "Unbekannte Meldung"}
  ENDSWITCH
END
